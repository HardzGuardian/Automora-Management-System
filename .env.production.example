# Copy to .env.production and fill in real values. NEVER commit the filled-in file.
# Generate secrets with:  openssl rand -base64 48

# --- Public address -------------------------------------------------------------------------------
APP_DOMAIN=app.example.com
ACME_EMAIL=admin@example.com
APP_URL=https://app.example.com
BETTER_AUTH_URL=https://app.example.com

# --- Secrets ---------------------------------------------------------------------------------------
BETTER_AUTH_SECRET=
CRON_SECRET=
POSTGRES_PASSWORD=

# --- Database (the compose file builds DATABASE_URL from these) ------------------------------------
POSTGRES_USER=automora
POSTGRES_DB=automora

# --- File storage (private bucket, any S3-compatible store) ----------------------------------------
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=automora
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email -----------------------------------------------------------------------------------------
SMTP_URL=smtp://user:password@smtp.example.com:587
EMAIL_FROM=Automora <no-reply@example.com>

# --- First admin (used once by `pnpm db:seed`) -----------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com

# --- Backups ---------------------------------------------------------------------------------------
# Encryption passphrase for backup files. Store it somewhere safe OFF this server: without it a backup cannot be restored.
BACKUP_PASSPHRASE=
BACKUP_RETENTION_DAYS=14
# Off-site copy (optional but strongly recommended), e.g. s3://my-backup-bucket/automora/
BACKUP_S3_URI=
BACKUP_S3_ENDPOINT=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=us-east-1

# --- Monitoring pings (optional; healthchecks.io style URLs) ---------------------------------------
BACKUP_PING_URL=
BACKUP_PING_FAIL_URL=
CRON_PING_URL=
